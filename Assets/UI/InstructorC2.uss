/* ============================================================
   InstructorC2.uss — C2 Station Stylesheet
   TRISHUL-SIM · UX-P0-A / UX-P2-C · MIL-STD-2525 palette
   via CSS custom properties
   ============================================================ */

/* --- CSS Custom Properties (MIL-STD-2525) --- */
:root {
    --mil-green: #00B300;
    --mil-amber: #FFB300;
    --mil-red: #CC0000;
    --bg: #0D0D0D;
    --bg-panel: #141414;
    --border-default: #333333;
    --border-subtle: #2A2A2A;
    --text-primary: #E0E0E0;
    --text-muted: #AAAAAA;
}

/* --- Root --- */
.c2-root {
    background-color: var(--bg);
    color: var(--text-primary);
    font-size: 14px;
    flex-grow: 1;
    padding: 16px;
    -unity-font-style: normal;
}

/* --- Status Bar --- */
.status-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    padding: 8px 12px;
    margin-bottom: 16px;
    background-color: #1A1A1A;
    border-radius: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-default);
}

.app-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: #FFFFFF;
    letter-spacing: 2px;
}

.status-group {
    flex-direction: row;
    align-items: center;
}

/* --- Status Icon (connection indicator) --- */
.status-icon {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin-right: 8px;
}

.status-waiting {
    background-color: #888888;
}

.status-connected {
    background-color: var(--mil-green);
}

.status-lost {
    background-color: var(--mil-red);
}

.status-label {
    font-size: 13px;
    color: var(--text-muted);
}

/* --- Controls Panel --- */
.controls-panel {
    padding: 16px;
    margin-bottom: 16px;
    background-color: var(--bg-panel);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--border-subtle);
}

.control-field {
    margin-bottom: 12px;
}

.control-field > Label {
    color: var(--text-muted);
    font-size: 12px;
    min-width: 140px;
}

.button-row {
    flex-direction: row;
    margin-top: 8px;
    flex-wrap: wrap;
}

/* --- Buttons --- */
.btn {
    padding: 8px 16px;
    margin-right: 8px;
    margin-bottom: 4px;
    border-radius: 3px;
    font-size: 13px;
    -unity-font-style: bold;
    border-width: 1px;
}

.btn-launch {
    background-color: var(--mil-green);
    color: #FFFFFF;
    border-color: #009900;
}

.btn-launch:hover {
    background-color: #00CC00;
}

.btn-abort {
    background-color: var(--mil-red);
    color: #FFFFFF;
    border-color: #990000;
}

.btn-abort:hover {
    background-color: #EE0000;
}

.btn-lang {
    background-color: #333333;
    color: var(--text-primary);
    border-color: #555555;
}

.btn-lang:hover {
    background-color: #444444;
}

/* --- Scorecard Panel (stub) --- */
.scorecard-panel {
    padding: 16px;
    background-color: var(--bg-panel);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--border-subtle);
}

.scorecard-stub {
    font-size: 14px;
    color: #888888;
    -unity-font-style: italic;
}

/* --- Utility --- */
.hidden {
    display: none;
}

/* --- MIL-STD-2525 Threat State Colours (shared) --- */
.threat-green {
    background-color: var(--mil-green);
}

.threat-amber {
    background-color: var(--mil-amber);
}

.threat-red {
    background-color: var(--mil-red);
}
