/* ====================================================
   TRISHUL-SIM  ·  C2 Station  ·  USS Theme
   MIL-STD-2525 colour palette:
     GREEN  #00B300  AMBER  #FFB300  RED  #CC0000
   ==================================================== */

.c2-root {
    flex-direction: column;
    background-color: #0D0D0D;
    color: #E0E0E0;
    font-size: 14px;
    width: 100%;
    height: 100%;
    padding: 16px;
}

/* --- Status Bar --- */
.status-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
    background-color: #1A1A1A;
    padding: 8px 12px;
    border-radius: 4px;
}

.app-title {
    font-size: 16px;
    color: #FFFFFF;
    -unity-font-style: bold;
    flex-grow: 1;
}

.status-icon {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin-right: 8px;
}

/* Status states */
.status-waiting   { background-color: #888888; }
.status-connected { background-color: #00B300; }  /* MIL-STD-2525 GREEN */
.status-lost      { background-color: #CC0000; }  /* MIL-STD-2525 RED   */

.status-label {
    color: #AAAAAA;
    font-size: 12px;
}

/* --- Control Group --- */
.control-group {
    flex-direction: column;
    margin-bottom: 12px;
}

.scenario-dropdown {
    margin-bottom: 8px;
    background-color: #1E1E1E;
    border-color: #444444;
    border-width: 1px;
    color: #E0E0E0;
}

.trainee-id {
    background-color: #1E1E1E;
    border-color: #444444;
    border-width: 1px;
    color: #E0E0E0;
}

/* --- Buttons --- */
.button-row {
    flex-direction: row;
    margin-bottom: 16px;
    flex-wrap: wrap;
}

.btn-launch {
    background-color: #004D00;
    border-color: #00B300;
    border-width: 1px;
    color: #00FF00;
    font-size: 13px;
    -unity-font-style: bold;
    margin-right: 8px;
    padding: 8px 16px;
    border-radius: 3px;
    flex-grow: 1;
}

.btn-launch:hover {
    background-color: #006600;
}

.btn-abort {
    background-color: #4D0000;
    border-color: #CC0000;
    border-width: 1px;
    color: #FF4444;
    font-size: 13px;
    -unity-font-style: bold;
    margin-right: 8px;
    padding: 8px 16px;
    border-radius: 3px;
}

.btn-abort:hover {
    background-color: #660000;
}

.btn-lang {
    background-color: #1A1A2E;
    border-color: #4466CC;
    border-width: 1px;
    color: #8899FF;
    font-size: 13px;
    padding: 8px 12px;
    border-radius: 3px;
}

.btn-lang:hover {
    background-color: #222244;
}

/* --- Scorecard Mirror Panel --- */
.scorecard-panel {
    background-color: #111122;
    border-color: #334499;
    border-width: 1px;
    border-radius: 4px;
    padding: 12px;
    flex-grow: 1;
}

.scorecard-stub {
    color: #8899FF;
    font-size: 12px;
}

/* --- Utility --- */
.hidden {
    display: none;
}

/* --- Threat state (shared, referenced from controllers) --- */
.threat-green { background-color: #00B300; }
.threat-amber { background-color: #FFB300; }
.threat-red   { background-color: #CC0000; }
