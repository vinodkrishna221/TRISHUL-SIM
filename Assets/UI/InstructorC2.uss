/* ============================================================
   InstructorC2.uss — C2 Station Stylesheet
   TRISHUL-SIM · UX-P0-A · MIL-STD-2525 colour palette
   ============================================================ */

/* --- Root --- */
.c2-root {
    background-color: #0D0D0D;
    color: #E0E0E0;
    font-size: 14px;
    flex-grow: 1;
    padding: 16px;
    -unity-font-style: normal;
}

/* --- Status Bar --- */
.status-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    margin-bottom: 16px;
    background-color: #1A1A1A;
    border-radius: 4px;
    border-bottom-width: 1px;
    border-bottom-color: #333333;
}

.app-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: #FFFFFF;
    letter-spacing: 2px;
}

.status-group {
    flex-direction: row;
    align-items: center;
}

/* --- Status Icon (connection indicator) --- */
.status-icon {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin-right: 8px;
}

.status-waiting {
    background-color: #888888;
}

.status-connected {
    background-color: #00B300; /* MIL-STD-2525 GREEN */
}

.status-lost {
    background-color: #CC0000; /* MIL-STD-2525 RED */
}

.status-label {
    font-size: 13px;
    color: #AAAAAA;
}

/* --- Controls Panel --- */
.controls-panel {
    padding: 16px;
    margin-bottom: 16px;
    background-color: #141414;
    border-radius: 4px;
    border-width: 1px;
    border-color: #2A2A2A;
}

.control-field {
    margin-bottom: 12px;
}

.control-field > Label {
    color: #AAAAAA;
    font-size: 12px;
    min-width: 140px;
}

.button-row {
    flex-direction: row;
    margin-top: 8px;
    flex-wrap: wrap;
}

/* --- Buttons --- */
.btn {
    padding: 8px 16px;
    margin-right: 8px;
    margin-bottom: 4px;
    border-radius: 3px;
    font-size: 13px;
    -unity-font-style: bold;
    border-width: 1px;
}

.btn-launch {
    background-color: #00B300;
    color: #FFFFFF;
    border-color: #009900;
}

.btn-launch:hover {
    background-color: #00CC00;
}

.btn-abort {
    background-color: #CC0000;
    color: #FFFFFF;
    border-color: #990000;
}

.btn-abort:hover {
    background-color: #EE0000;
}

.btn-lang {
    background-color: #333333;
    color: #E0E0E0;
    border-color: #555555;
}

.btn-lang:hover {
    background-color: #444444;
}

/* --- Scorecard Panel (stub) --- */
.scorecard-panel {
    padding: 16px;
    background-color: #141414;
    border-radius: 4px;
    border-width: 1px;
    border-color: #2A2A2A;
}

.scorecard-stub {
    font-size: 14px;
    color: #888888;
    -unity-font-style: italic;
}

/* --- Utility --- */
.hidden {
    display: none;
}

/* --- MIL-STD-2525 Threat State Colours (shared) --- */
.threat-green {
    background-color: #00B300;
}

.threat-amber {
    background-color: #FFB300;
}

.threat-red {
    background-color: #CC0000;
}

/* --- VR Mode & Gyro Status (VG-P1-E) --- */
.btn-vr-mode {
    background-color: #0077BE;
    color: #FFFFFF;
    border-color: #005588;
}

.btn-vr-mode:hover {
    background-color: #0099EE;
}

.btn-vr-active {
    background-color: #00B300;
    color: #FFFFFF;
    border-color: #008800;
}

.vr-status-badge {
    margin-left: 12px;
}
