/* ============================================================
   TraineeCockpit.uss — Trainee Cockpit Stylesheet
   TRISHUL-SIM · UX-P0-A / UX-P1-A / UX-P1-B / UX-P2-C
   MIL-STD-2525 palette via CSS custom properties
   ============================================================ */

/* --- CSS Custom Properties (MIL-STD-2525) --- */
:root {
    --mil-green: #00B300;
    --mil-amber: #FFB300;
    --mil-red: #CC0000;
    --bg: #0D0D0D;
    --bg-panel: #111111;
    --bg-controls: #141414;
    --bg-dark: #181818;
    --border-default: #333333;
    --border-subtle: #2A2A2A;
    --text-primary: #E0E0E0;
    --text-muted: #888888;
    --text-dim: #555555;
}

/* --- Root --- */
.cockpit-root {
    background-color: var(--bg);
    color: var(--text-primary);
    font-size: 14px;
    flex-grow: 1;
    padding: 8px;
}

/* --- Threat Indicator --- */
.threat-indicator {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 6px 16px;
    margin-bottom: 8px;
    border-radius: 4px;
    min-height: 32px;
    transition-duration: 0.3s;
    transition-property: background-color, opacity;
}

.threat-text {
    font-size: 16px;
    -unity-font-style: bold;
    color: #FFFFFF;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

.threat-green {
    background-color: var(--mil-green);
}

.threat-amber {
    background-color: var(--mil-amber);
}

.threat-red {
    background-color: var(--mil-red);
}

/* --- Threat RED Pulse Animation --- */
.threat-red-pulse {
    background-color: var(--mil-red);
}

/* USS does not support @keyframes natively; pulse is driven by
   CockpitController toggling opacity between 1.0 and 0.4 on a
   coroutine timer. The transition-duration above provides the smooth
   fade. The class names below are toggled programmatically: */
.pulse-bright {
    opacity: 1.0;
}

.pulse-dim {
    opacity: 0.4;
}

/* --- Sensor Row --- */
.sensor-row {
    flex-direction: row;
    flex-grow: 1;
    margin-bottom: 8px;
}

/* --- Sensor Pane (each of the 3 panes) --- */
.sensor-pane {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 4px;
    background-color: var(--bg-panel);
    border-width: 1px;
    border-color: var(--border-default);
    border-radius: 4px;
    padding: 4px;
    min-width: 200px;
    transition-duration: 0.3s;
    transition-property: border-color;
}

/* Sensor pane borders follow threat state */
.sensor-pane-green {
    border-color: var(--mil-green);
}

.sensor-pane-amber {
    border-color: var(--mil-amber);
}

.sensor-pane-red {
    border-color: var(--mil-red);
}

.pane-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--mil-green);
    letter-spacing: 2px;
    -unity-text-align: upper-center;
    padding: 4px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
    margin-bottom: 4px;
}

/* --- Sensor Content --- */
.sensor-content {
    flex-grow: 1;
    background-color: #1A1A1A;
    border-radius: 2px;
    min-height: 200px;
    justify-content: center;
    align-items: center;
    position: relative;
}

.stub-label {
    font-size: 11px;
    color: var(--text-dim);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
}

/* --- Frequency Markers (RF Waterfall) --- */
.freq-markers {
    flex-direction: row;
    justify-content: space-between;
    padding: 2px 4px;
}

.freq-marker {
    font-size: 9px;
    color: #666666;
}

/* --- Sensor Reading Labels --- */
.sensor-reading {
    font-size: 11px;
    color: var(--text-muted);
    -unity-text-align: upper-center;
    padding: 4px 0;
}

/* --- SMASH 2000 Reticle Overlay (over Doppler Scope) --- */
.smash-reticle-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.smash-crosshair {
    width: 60px;
    height: 60px;
    position: relative;
    justify-content: center;
    align-items: center;
}

.reticle-ring {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    border-width: 2px;
    border-color: #00FF00;
}

.reticle-locked .reticle-ring {
    border-color: #FFFF00;
}

.reticle-hit .reticle-ring {
    border-color: #00FF00;
    background-color: rgba(0, 255, 0, 0.25);
}

.reticle-miss .reticle-ring {
    border-color: var(--mil-red);
    background-color: rgba(204, 0, 0, 0.25);
}

.reticle-h-bar {
    position: absolute;
    width: 56px;
    height: 1px;
    background-color: rgba(0, 255, 0, 0.7);
}

.reticle-v-bar {
    position: absolute;
    width: 1px;
    height: 56px;
    background-color: rgba(0, 255, 0, 0.7);
}

.smash-lead-vector {
    position: absolute;
    width: 12px;
    height: 2px;
    background-color: #FFFF00;
    left: 36px;
    top: 29px;
}

.smash-target-tag {
    position: absolute;
    top: 6px;
    left: 6px;
    font-size: 10px;
    color: #FFFF00;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 2px 4px;
    border-radius: 2px;
}

/* --- Controls Row (EW + SMASH) --- */
.controls-row {
    flex-direction: row;
    padding: 8px;
    background-color: var(--bg-controls);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--border-subtle);
    margin-bottom: 8px;
}

.controls-panel {
    flex-grow: 1;
    flex-basis: 0;
    background-color: var(--bg-dark);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--border-default);
    padding: 8px;
    margin: 0 4px;
}

.panel-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--mil-green);
    letter-spacing: 1px;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
    padding-bottom: 2px;
}

.control-slider {
    margin-bottom: 4px;
    font-size: 11px;
}

.control-dropdown {
    margin-bottom: 4px;
    font-size: 11px;
}

.control-toggle {
    margin-bottom: 4px;
    font-size: 11px;
}

/* --- ROE Violation Warning --- */
.roe-warning {
    font-size: 11px;
    -unity-font-style: bold;
    color: #FFFFFF;
    background-color: var(--mil-red);
    padding: 4px 8px;
    border-radius: 3px;
    -unity-text-align: middle-center;
    margin-top: 4px;
    letter-spacing: 1px;
}

.roe-warning-active {
    border-width: 1px;
    border-color: #FF6666;
}

/* --- SMASH Fire Control Panel Details --- */
.smash-status-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 6px;
    padding: 4px;
    background-color: #0F0F0F;
    border-radius: 3px;
}

.smash-lock-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--text-muted);
}

.locked-active {
    color: #FFFF00;
}

.smash-lead-label {
    font-size: 11px;
    color: var(--mil-green);
    -unity-font-style: bold;
}

.fire-btn {
    height: 36px;
    background-color: #8B0000;
    color: #FFFFFF;
    -unity-font-style: bold;
    font-size: 13px;
    letter-spacing: 2px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--mil-red);
    margin-top: 4px;
    margin-bottom: 4px;
}

.fire-btn:hover {
    background-color: #B22222;
}

.fire-btn:active {
    background-color: #FF0000;
}

.smash-feedback-label {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding: 4px 8px;
    border-radius: 3px;
    -unity-text-align: middle-center;
    margin-top: 4px;
}

.feedback-hit {
    background-color: var(--mil-green);
    color: #FFFFFF;
}

.feedback-miss {
    background-color: var(--mil-red);
    color: #FFFFFF;
}

/* --- Scorecard Panel (stub) --- */
.scorecard-panel {
    padding: 16px;
    background-color: var(--bg-controls);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--border-subtle);
}

.scorecard-stub {
    font-size: 14px;
    color: var(--text-muted);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
}

/* --- Computing Overlay --- */
.computing-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    justify-content: center;
    align-items: center;
}

.computing-text {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--mil-amber);
    letter-spacing: 2px;
}

/* ============================================================
   NIGHT MODE (UX-P2-C) — Punjab Pincer / isNight=true
   Applied by CockpitController when WeatherPreset.isNight == true
   ============================================================ */

/* Pitch-black background — PRD §3 Beat 4 aesthetic */
.night-mode {
    background-color: #000000;
}

/* Glowing sensor pane borders in night mode */
.night-mode .sensor-pane {
    border-color: var(--mil-green);
    border-width: 2px;
}

/* Night-mode pane titles glow brighter */
.night-mode .pane-title {
    color: #33FF33;
}

/* Night-mode controls panel subtle green accent */
.night-mode .controls-row {
    background-color: #0A0A0A;
    border-color: #1A3A1A;
}

/* ============================================================
   FOG OVERLAY (UX-P2-C)
   Placed behind sensors as a subtle atmospheric haze
   ============================================================ */
.fog-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: #B0C4DE;
    opacity: 0.12;
}

/* --- Utility --- */
.hidden {
    display: none;
}
