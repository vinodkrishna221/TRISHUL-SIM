<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="InstructorC2.uss" />
    <ui:VisualElement class="c2-root">
        <!-- Status Bar -->
        <ui:VisualElement class="status-bar">
            <ui:Label name="app-title" text="TRISHUL-SIM · C2 STATION" class="app-title" />
            <ui:VisualElement class="status-group">
                <ui:VisualElement name="link-status-icon" class="status-icon status-waiting" />
                <ui:Label name="link-status-label" text="○ Waiting for Trainee..." class="status-label" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Controls Panel -->
        <ui:VisualElement class="controls-panel">
            <ui:DropdownField name="scenario-dropdown" label="Scenario" class="control-field" />
            <ui:TextField name="trainee-id" label="Trainee ID (optional)" class="control-field" />
            <ui:VisualElement class="button-row">
                <ui:Button name="launch-btn" text="LAUNCH SCENARIO" class="btn btn-launch" />
                <ui:Button name="abort-btn" text="ABORT" class="btn btn-abort" />
                <ui:Button name="lang-toggle" text="हिंदी" class="btn btn-lang" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Scorecard Mirror (shown after SCORECARD_PAYLOAD) -->
        <ui:VisualElement name="scorecard-mirror" class="scorecard-panel hidden">
            <ui:Label name="scorecard-stub-label" text="Scorecard: awaiting data..." class="scorecard-stub" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
