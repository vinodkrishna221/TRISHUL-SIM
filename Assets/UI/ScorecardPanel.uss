/* ============================================================
   ScorecardPanel.uss — Tactical Performance Scorecard Stylesheet
   TRISHUL-SIM · UX-P1-D · MIL-STD-2525 colour palette
   ============================================================ */

.scorecard-root {
    background-color: #0E0E0E;
    color: #E0E0E0;
    font-size: 13px;
    padding: 12px 16px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #2A2A2A;
    flex-grow: 1;
}

/* --- Header Section --- */
.scorecard-header {
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: #222222;
    padding-bottom: 8px;
}

.scorecard-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #00B300; /* MIL-STD-2525 GREEN */
    letter-spacing: 2px;
    margin-bottom: 4px;
}

.scorecard-subbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.scenario-name {
    font-size: 13px;
    color: #FFFFFF;
    -unity-font-style: bold;
}

.trainee-id-label {
    font-size: 12px;
    color: #888888;
}

/* --- Doctrine Badge --- */
.badge {
    padding: 6px 16px;
    border-radius: 4px;
    align-self: flex-start;
    margin-top: 4px;
    margin-bottom: 4px;
}

.badge-text {
    font-size: 14px;
    -unity-font-style: bold;
    color: #FFFFFF;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}

.badge-pass {
    background-color: #00B300; /* MIL-STD-2525 GREEN */
}

.badge-fail {
    background-color: #CC0000; /* MIL-STD-2525 RED */
}

/* --- Section Headings --- */
.section-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: #888888;
    letter-spacing: 1.5px;
    margin-bottom: 6px;
}

/* --- Metrics Table --- */
.metrics-section {
    margin-bottom: 14px;
    background-color: #121212;
    border-radius: 4px;
    padding: 8px 10px;
    border-width: 1px;
    border-color: #222222;
}

.metrics-header-row {
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: #333333;
    padding-bottom: 4px;
    margin-bottom: 4px;
}

.th-metric {
    flex: 3;
    font-size: 10px;
    color: #777777;
    -unity-font-style: bold;
}

.th-value {
    flex: 2;
    font-size: 10px;
    color: #777777;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.th-benchmark {
    flex: 2;
    font-size: 10px;
    color: #777777;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.th-verdict {
    flex: 1.5;
    font-size: 10px;
    color: #777777;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.metric-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 0;
    border-bottom-width: 1px;
    border-bottom-color: #1A1A1A;
}

.metric-col-name {
    flex: 3;
    font-size: 12px;
    color: #D0D0D0;
}

.metric-col-val {
    flex: 2;
    font-size: 12px;
    color: #FFFFFF;
    -unity-font-style: bold;
}

.metric-col-bench {
    flex: 2;
    font-size: 11px;
    color: #888888;
}

.metric-col-verdict {
    flex: 1.5;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.metric-pass {
    color: #00B300; /* MIL-STD-2525 GREEN */
}

.metric-fail {
    color: #CC0000; /* MIL-STD-2525 RED */
}

.metric-info {
    color: #888888;
}

/* --- Timeline Section --- */
.timeline-section {
    background-color: #121212;
    border-radius: 4px;
    padding: 8px 10px;
    border-width: 1px;
    border-color: #222222;
    margin-bottom: 12px;
}

.timeline-header-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.timeline-time {
    font-size: 13px;
    -unity-font-style: bold;
    color: #FFB300; /* MIL-STD-2525 AMBER */
    letter-spacing: 1px;
}

.timeline-slider {
    margin: 4px 0 8px 0;
}

/* --- Spatial Radar Overlay --- */
.spatial-radar-container {
    align-items: center;
    justify-content: center;
}

.spatial-overlay {
    width: 100%;
    height: 180px;
    background-color: #080808;
    border-radius: 4px;
    border-width: 1px;
    border-color: #262626;
    position: relative;
    overflow: hidden;
}

.trainee-marker {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    margin-top: -4px;
    background-color: #FFFFFF;
    border-radius: 4px;
}

.radar-range-ring-1 {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 90px;
    height: 90px;
    margin-left: -45px;
    margin-top: -45px;
    border-width: 1px;
    border-color: #1E3A1E;
    border-radius: 50%;
}

.radar-range-ring-2 {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 160px;
    height: 160px;
    margin-left: -80px;
    margin-top: -80px;
    border-width: 1px;
    border-color: #152A15;
    border-radius: 50%;
}

.radar-crosshair-h {
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1px;
    background-color: #1A2E1A;
}

.radar-crosshair-v {
    position: absolute;
    left: 50%;
    top: 0;
    width: 1px;
    height: 100%;
    background-color: #1A2E1A;
}

.drone-blip-container {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

/* Agent Blips */
.drone-blip {
    position: absolute;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    margin-top: -4px;
    border-radius: 4px;
}

.dot-decoy {
    background-color: #0088FF; /* Decoy Blue */
}

.dot-attacker {
    background-color: #CC0000; /* Attacker Red */
}

.dot-neutralised {
    background-color: #555555; /* Neutralised Grey */
}

.radar-legend {
    flex-direction: row;
    justify-content: space-around;
    width: 100%;
    margin-top: 6px;
}

.legend-item {
    flex-direction: row;
    align-items: center;
}

.legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 4px;
}

.legend-text {
    font-size: 10px;
    color: #888888;
}

/* --- Actions & PDF Export (UX-P2-A) --- */
.scorecard-actions {
    flex-direction: column;
    align-items: flex-end;
    margin-top: 6px;
}

.pdf-export-row {
    flex-direction: row;
    align-items: center;
}

.btn-pdf-export {
    background-color: #00B300;
    color: #FFFFFF;
    border-color: #009900;
    font-size: 12px;
    padding: 6px 14px;
    border-radius: 3px;
    -unity-font-style: bold;
}

.btn-pdf-export:hover {
    background-color: #00CC00;
}

.spinner {
    width: 18px;
    height: 18px;
    border-width: 2px;
    border-color: #00B300;
    border-top-color: rgba(0, 0, 0, 0);
    border-radius: 9px;
    margin-left: 8px;
    transition: rotate 1s linear;
}

.pdf-status-label {
    font-size: 11px;
    color: #00B300;
    margin-top: 4px;
}

.pdf-error-label {
    font-size: 11px;
    color: #CC0000;
    margin-top: 4px;
    -unity-font-style: bold;
}
